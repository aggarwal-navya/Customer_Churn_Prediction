+3.12
diff --git a/.vercelignore b/.vercelignore
new file mode 100644
index 0000000..e915238
--- /dev/null
+++ b/.vercelignore
@@ -0,0 +1,15 @@
+# Not needed at prediction time - keeps the Vercel bundle small
+mlruns/
+mlflow.db
+artifacts/
+catboost_info/
+logs/
+data/
+Telco-Customer-Churn.csv
+*.ipynb
+*.egg-info/
+**/__pycache__/
+DOCUMENTATION.md
+Dockerfile
+requirements-train.txt
+models/training.log
diff --git a/Dockerfile b/Dockerfile
index 05608c1..4b2bd8b 100644
--- a/Dockerfile
+++ b/Dockerfile
@@ -1,5 +1,5 @@
 # Base Python Slim Image
-FROM python:3.9-slim
+FROM python:3.11-slim
 
 # System dependencies (like git or compiler if needed by xgboost/catboost)
 RUN apt-get update && apt-get install -y \
@@ -10,25 +10,26 @@ RUN apt-get update && apt-get install -y \
 WORKDIR /app
 
 # Copy Requirements
-COPY requirements.txt .
+COPY requirements.txt requirements-train.txt ./
 
 # Install Packages
-RUN pip install --no-cache-dir -r requirements.txt
+RUN pip install --no-cache-dir -r requirements-train.txt
 
 # Copy Project Files
 COPY src/ ./src/
 COPY templates/ ./templates/
-COPY static/ ./static/
+COPY public/ ./public/
 COPY setup.py .
 COPY main.py .
 COPY app.py .
+COPY data/ ./data/
 COPY Telco-Customer-Churn.csv .
 
 # Install local package
 RUN pip install -e .
 
 # Expose port
-EXPOSE 5000
+EXPOSE 5001
 
 # Train model first, then run Flask web app
 CMD ["sh", "-c", "python main.py && python app.py"]
diff --git a/app.py b/app.py
index 6fc1097..216aedf 100644
--- a/app.py
+++ b/app.py
@@ -7,7 +7,11 @@ from src.customer_churn_prediction.pipelines.prediction_pipeline import PredictP
 
 training_process = None
 
-app = Flask(__name__)
+IS_VERCEL = bool(os.environ.get('VERCEL'))
+
+# Static files live in public/ (Vercel serves public/ from its CDN at the site root).
+# Locally, Flask serves the same folder at the same URLs.
+app = Flask(__name__, static_folder='public', static_url_path='')
 app.config['SEND_FILE_MAX_AGE_DEFAULT'] = 0
 
 @app.after_request
@@ -87,6 +91,8 @@ def get_metrics_endpoint():
 @app.route('/train', methods=['POST'])
 def train_model():
     global training_process
+    if IS_VERCEL:
+        return jsonify({"status": "error", "message": "Retraining is disabled on Vercel (read-only, short-lived serverless functions). Run `python main.py` locally and commit the new files in models/."}), 503
     try:
         if training_process and training_process.poll() is None:
             return jsonify({"status": "error", "message": "Training pipeline is already running."}), 400
@@ -115,6 +121,8 @@ def train_model():
 
 @app.route('/train/stream', methods=['GET'])
 def train_stream():
+    if IS_VERCEL:
+        return Response('data: [EOF]\n\n', mimetype='text/event-stream')
     def generate():
         import time
         log_path = "models/training.log"
@@ -160,4 +168,5 @@ def get_feature_importance():
     ])
 
 if __name__ == '__main__':
-    app.run(host='0.0.0.0', port=5001, debug=True)
+    # Debug mode exposes the Werkzeug debugger (remote code execution) - enable only via env var
+    app.run(host='0.0.0.0', port=5001, debug=os.environ.get('FLASK_DEBUG', '0') == '1')
