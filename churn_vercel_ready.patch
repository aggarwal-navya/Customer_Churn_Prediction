             features_df['MonthlyCharges'] = features_df['MonthlyCharges'].astype(float)
             features_df['TotalCharges'] = features_df['TotalCharges'].astype(float)
 
-            # One-Hot Encoding manually
-            features_encoded = pd.get_dummies(features_df, columns=categorical_cols, drop_first=True)
+            # One-Hot Encoding manually.
+            # NOTE: do NOT use drop_first=True here. With a single input row every categorical
+            # column has only one level, so drop_first would remove ALL of them and the model
+            # would silently ignore every categorical input. Instead encode every level and let
+            # the reindex below keep only the columns the model was trained on (the baseline
+            # level of each feature is simply absent, i.e. all zeros, exactly as in training).
+            features_encoded = pd.get_dummies(features_df, columns=categorical_cols, drop_first=False)
 
             # Reindex to match the columns list from training
             features_aligned = features_encoded.reindex(columns=model_columns, fill_value=0)
